// Ápice 360 — schema de dados do site institucional + painel de administração.
// Padrão de i18n: tabelas de tradução relacionais (<Model>Translation) em vez de
// colunas _pt/_en, para permitir adicionar idiomas sem migrar tabelas de conteúdo
// e para que o admin use um único componente <LocaleTabs> genérico.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  PT
  EN
  ES
  FR
}

enum Role {
  ADMIN
  EDITOR
}

enum PageKey {
  HOME
  QUEM_SOMOS
  SERVICOS
  PORTFOLIO
  BLOG
  CONTACTO
  AREA_ARQUITETO
  LP
  LSF
}

enum ProjectCategory {
  LSF
  REMODELACAO
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadType {
  CONTACT
  BUDGET
  ARCHITECT_PARTNERSHIP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadActivityType {
  STATUS_CHANGE
  NOTE
  CALL_LOGGED
  EMAIL_LOGGED
  ASSIGNMENT
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  passwordHash   String
  role           Role             @default(EDITOR)
  isActive       Boolean          @default(true)
  groupId        String?
  group          Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  blogPosts      BlogPost[]       @relation("PostAuthor")
  assignedLeads  LeadSubmission[] @relation("LeadAssignee")
  leadActivities LeadActivity[]
  sentEmails     EmailMessage[]   @relation("EmailSender")
}

/// Optional, granular permission tier layered on top of Role — only applies
/// to EDITOR accounts explicitly assigned to a group (User.groupId). An
/// EDITOR with no group keeps today's behavior exactly (full access);
/// ADMIN always bypasses this regardless of group. See src/lib/permissions.ts.
model Group {
  id          String            @id @default(cuid())
  name        String            @unique
  isSystem    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  permissions GroupPermission[]
  users       User[]
}

model GroupPermission {
  id        String  @id @default(cuid())
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resource  String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([groupId, resource])
}

model SiteSettings {
  id                   String                    @id @default("singleton")
  phone                String?
  whatsappCommercial   String?
  whatsappGeneral      String?
  email                String?
  addressLine          String?
  addressCity          String?
  addressPostalCode    String?
  addressCountry       String?                   @default("Portugal")
  /// Mantido por compatibilidade: nunca foi lido por nada. O mapa dos
  /// contactos usa mapLatitude/mapLongitude.
  mapEmbedUrl          String?
  /// Ponto do mapa da página de contactos. Sem valores, cai nas coordenadas
  /// da sede em Amora, Seixal.
  mapLatitude          Float?
  mapLongitude         Float?
  socialFacebook       String?
  socialInstagram      String?
  socialLinkedin       String?
  socialYoutube        String?
  defaultOgImageUrl    String?
  nif                  String?
  partnersDisplayMode  String                    @default("GRID")
  architectAreaEnabled Boolean                   @default(true)
  /// Liga/desliga a página informativa /lsf (link no menu + acesso à rota).
  lsfPageEnabled       Boolean                   @default(true)
  /// Liga/desliga o blog: link no menu e no rodapé, e acesso às rotas.
  blogEnabled          Boolean                   @default(true)
  maintenanceMode      Boolean                   @default(false)
  /// ID de medição do Google Analytics 4 (G-XXXXXXXXXX). Vazio desliga o GA.
  gaMeasurementId      String?
  /// ID do pixel do Meta/Facebook Ads (só dígitos). Vazio desliga o pixel.
  metaPixelId          String?
  updatedAt            DateTime                  @updatedAt
  translations         SiteSettingsTranslation[]
}

model SiteSettingsTranslation {
  id                    String       @id @default(cuid())
  siteSettingsId        String
  siteSettings          SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)
  locale                Locale
  isAutoTranslated      Boolean      @default(false)
  footerDescription     String?
  /// Linha legal do fundo do rodapé. "{ano}" é substituído pelo ano corrente.
  footerLegal           String?
  /// Frase curta ao centro do fundo do rodapé.
  footerTagline         String?
  showroomText          String?
  defaultSeoTitle       String?
  defaultSeoDescription String?

  @@unique([siteSettingsId, locale])
}

model Cta {
  id           String           @id @default(cuid())
  key          String           @unique
  url          String
  style        String?          @default("primary")
  iconName     String?
  isActive     Boolean          @default(true)
  updatedAt    DateTime         @updatedAt
  translations CtaTranslation[]
}

model CtaTranslation {
  id               String  @id @default(cuid())
  ctaId            String
  cta              Cta     @relation(fields: [ctaId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean @default(false)
  label            String

  @@unique([ctaId, locale])
}

model PageSeo {
  id           String               @id @default(cuid())
  page         PageKey              @unique
  ogImageUrl   String?
  translations PageSeoTranslation[]
}

model PageSeoTranslation {
  id               String  @id @default(cuid())
  pageSeoId        String
  pageSeo          PageSeo @relation(fields: [pageSeoId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean @default(false)
  title            String
  description      String

  @@unique([pageSeoId, locale])
}

/// Blocos de conteúdo genéricos e reutilizáveis: Home (parceiros/porquê-escolher/
/// resultados/blog-preview), Quem Somos (história/método/valores), Serviços
/// (modelo chave-na-mão), Contacto (triagem/showroom). Pertence a uma página
/// fixa (page) OU a uma página personalizada (customPageId) — nunca as duas.
/// São duas restrições @@unique separadas (não uma composta) porque o
/// Postgres nunca aplica unicidade numa linha com NULL numa das colunas —
/// uma composta [page, customPageId, key] nunca seria realmente aplicada,
/// já que uma das duas colunas está sempre a NULL.
model PageSection {
  id           String                   @id @default(cuid())
  page         PageKey?
  customPageId String?
  customPage   CustomPage?              @relation(fields: [customPageId], references: [id], onDelete: Cascade)
  key          String
  /// Como a GenericPageSection desenha esta secção quando não é uma das
  /// hand-built (standard/grid/timeline) — ver src/components/sections/GenericPageSection.tsx.
  layout       String                   @default("standard")
  order        Int                      @default(0)
  imageUrl     String?
  iconName     String?
  ctaKey       String?
  isActive     Boolean                  @default(true)
  translations PageSectionTranslation[]
  items        PageSectionItem[]

  @@unique([page, key])
  @@unique([customPageId, key])
}

/// Páginas criadas pelo admin (fora das páginas fixas), com o seu próprio
/// conjunto de PageSection ligado por customPageId.
model CustomPage {
  id           String                  @id @default(cuid())
  slug         String                  @unique
  order        Int                     @default(0)
  showInMenu   Boolean                 @default(true)
  isPublished  Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations CustomPageTranslation[]
  sections     PageSection[]
}

model CustomPageTranslation {
  id               String     @id @default(cuid())
  customPageId     String
  customPage       CustomPage @relation(fields: [customPageId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean    @default(false)
  navLabel         String
  heading          String?
  seoTitle         String?
  seoDescription   String?

  @@unique([customPageId, locale])
}

model PageSectionTranslation {
  id               String      @id @default(cuid())
  sectionId        String
  section          PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean     @default(false)
  eyebrow          String?
  heading          String?
  subheading       String?
  body             String?
  ctaLabel         String?

  @@unique([sectionId, locale])
}

/// Itens repetíveis dentro de uma secção: bullets do "porquê escolher", pilares
/// do "método", "valores", features de serviços simples, etc.
model PageSectionItem {
  id           String                       @id @default(cuid())
  sectionId    String
  section      PageSection                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order        Int                          @default(0)
  iconName     String?
  imageUrl     String?
  numberLabel  String?
  ctaKey       String?
  translations PageSectionItemTranslation[]
}

model PageSectionItemTranslation {
  id               String          @id @default(cuid())
  itemId           String
  item             PageSectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean         @default(false)
  title            String
  body             String?

  @@unique([itemId, locale])
}

model Stat {
  id           String            @id @default(cuid())
  iconName     String?
  value        String
  order        Int               @default(0)
  isActive     Boolean           @default(true)
  translations StatTranslation[]
}

model StatTranslation {
  id               String  @id @default(cuid())
  statId           String
  stat             Stat    @relation(fields: [statId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean @default(false)
  label            String

  @@unique([statId, locale])
}

model Partner {
  id         String  @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String?
  cardSize   String  @default("MD")
  order      Int     @default(0)
  isActive   Boolean @default(true)
}

model Testimonial {
  id           String                   @id @default(cuid())
  authorName   String
  location     String?
  avatarUrl    String?
  rating       Int?                     @default(5)
  showOnHome   Boolean                  @default(true)
  order        Int                      @default(0)
  isActive     Boolean                  @default(true)
  translations TestimonialTranslation[]
}

model TestimonialTranslation {
  id               String      @id @default(cuid())
  testimonialId    String
  testimonial      Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean     @default(false)
  quote            String

  @@unique([testimonialId, locale])
}

model Service {
  id           String               @id @default(cuid())
  type         String               @unique
  order        Int                  @default(0)
  imageUrl     String?
  ctaKey       String?
  isActive     Boolean              @default(true)
  translations ServiceTranslation[]
  features     ServiceFeature[]
}

model ServiceTranslation {
  id               String  @id @default(cuid())
  serviceId        String
  service          Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean @default(false)
  cardLabel        String
  title            String
  intro            String

  @@unique([serviceId, locale])
}

model ServiceFeature {
  id           String                      @id @default(cuid())
  serviceId    String
  service      Service                     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  order        Int                         @default(0)
  iconName     String?
  translations ServiceFeatureTranslation[]
}

model ServiceFeatureTranslation {
  id               String         @id @default(cuid())
  featureId        String
  feature          ServiceFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean        @default(false)
  title            String
  body             String?

  @@unique([featureId, locale])
}

model PortfolioProject {
  id             String               @id @default(cuid())
  slug           String               @unique
  category       ProjectCategory
  isFeatured     Boolean              @default(false)
  locationLabel  String?
  clientName     String?
  clientLocation String?
  coverImageUrl  String?
  order          Int                  @default(0)
  isPublished    Boolean              @default(true)
  publishedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  translations   ProjectTranslation[]
  images         ProjectImage[]
}

model ProjectTranslation {
  id               String           @id @default(cuid())
  projectId        String
  project          PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean          @default(false)
  title            String
  shortDescription String?
  challenge        String?
  methodology      String?
  result           String?
  testimonialQuote String?

  @@unique([projectId, locale])
}

model ProjectImage {
  id        String           @id @default(cuid())
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int              @default(0)
  /// "IMAGE" ou "VIDEO" — a galeria do portefólio aceita ambos.
  mediaType String           @default("IMAGE")
}

model BlogCategory {
  id           String                    @id @default(cuid())
  order        Int                       @default(0)
  translations BlogCategoryTranslation[]
  posts        BlogPost[]
}

model BlogCategoryTranslation {
  id               String       @id @default(cuid())
  categoryId       String
  category         BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean      @default(false)
  name             String
  slug             String

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model BlogPost {
  id               String                @id @default(cuid())
  categoryId       String?
  category         BlogCategory?         @relation(fields: [categoryId], references: [id])
  authorId         String?
  author           User?                 @relation("PostAuthor", fields: [authorId], references: [id])
  featuredImageUrl String?
  status           PostStatus            @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  translations     BlogPostTranslation[]
  comments         BlogComment[]
}

model BlogPostTranslation {
  id               String   @id @default(cuid())
  postId           String
  post             BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean  @default(false)
  slug             String
  title            String
  excerpt          String?
  bodyHtml         String
  seoTitle         String?
  seoDescription   String?

  @@unique([postId, locale])
  @@unique([locale, slug])
}

model BlogComment {
  id           String        @id @default(cuid())
  postId       String
  post         BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName   String
  authorEmail  String
  body         String
  status       CommentStatus @default(PENDING)
  likeCount    Int           @default(0)
  dislikeCount Int           @default(0)
  createdAt    DateTime      @default(now())
}

model LeadSubmission {
  id           String         @id @default(cuid())
  refNumber    Int            @unique @default(autoincrement())
  type         LeadType
  name         String
  email        String
  phone        String?
  message      String?
  sourcePage   String?
  locale       Locale
  status       LeadStatus     @default(NEW)
  notes        String?
  assignedToId String?
  assignedTo   User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  activities   LeadActivity[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([assignedToId])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      LeadSubmission   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  note      String?
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([leadId])
}

/// Escalões de preço por m² usados pelo simulador da landing page (/lp).
/// O resultado do simulador mostra um cartão por escalão ativo, pela ordem
/// definida aqui — tipicamente Económica, Conforto (destacada) e Premium.
model LpPriceTier {
  id            String                   @id @default(cuid())
  key           String                   @unique
  /// Preço por m² em euros (sem IVA), usado como `metros quadrados × preço`.
  pricePerM2    Int
  order         Int                      @default(0)
  /// Cartão em destaque no resultado — a opção que a Ápice 360 recomenda.
  isHighlighted Boolean                  @default(false)
  iconName      String?
  isActive      Boolean                  @default(true)
  updatedAt     DateTime                 @updatedAt
  translations  LpPriceTierTranslation[]
}

model LpPriceTierTranslation {
  id               String      @id @default(cuid())
  tierId           String
  tier             LpPriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean     @default(false)
  label            String
  description      String?
  /// Bullets do cartão, uma por linha (texto simples).
  features         String?

  @@unique([tierId, locale])
}

/// Tipo de campo do formulário do simulador da landing page.
enum LpFieldType {
  TEXT
  EMAIL
  TEL
  NUMBER
  TEXTAREA
  SELECT
  CHOICE
}

/// Campos do formulário do simulador (/lp#simulador), geridos no painel.
/// A resposta de cada campo ativo é gravada na lead, por isso acrescentar um
/// campo aqui é acrescentar uma pergunta ao formulário e uma linha à lead.
model LpSimulatorField {
  id           String                        @id @default(cuid())
  /// Nome técnico com que a resposta viaja e fica identificada na lead.
  key          String                        @unique
  type         LpFieldType                   @default(TEXT)
  /// Passo do assistente onde o campo aparece (1 a 3).
  step         Int                           @default(1)
  order        Int                           @default(0)
  isRequired   Boolean                       @default(false)
  isActive     Boolean                       @default(true)
  /// Ocupa meia linha, para dois campos curtos ficarem lado a lado.
  isHalfWidth  Boolean                       @default(false)
  /// Campos de que o simulador depende: identificam a lead (nome, email,
  /// telefone) ou entram na conta da estimativa (metros quadrados). O painel
  /// deixa mudar o rótulo, o passo e a ordem; não deixa apagar nem desligar.
  isSystem     Boolean                       @default(false)
  updatedAt    DateTime                      @updatedAt
  translations LpSimulatorFieldTranslation[]

  @@index([step, order])
}

model LpSimulatorFieldTranslation {
  id               String           @id @default(cuid())
  fieldId          String
  field            LpSimulatorField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  locale           Locale
  isAutoTranslated Boolean          @default(false)
  label            String
  /// Texto de ajuda por baixo do campo.
  hint             String?
  /// Opções de escolha, uma por linha — só para SELECT e CHOICE.
  options          String?

  @@unique([fieldId, locale])
}

// ---------------------------------------------------------------------------
// Caixa de correio do painel (integrada com o Resend)
// ---------------------------------------------------------------------------

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailFolder {
  INBOX
  SENT
  ARCHIVE
  TRASH
  SPAM
}

/// Último estado conhecido de uma mensagem. Para as enviadas vem dos webhooks
/// do Resend, que chegam minutos depois do envio.
enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
  RECEIVED
}

/// Endereços que o painel usa para enviar e onde recebe. O domínio tem de
/// estar verificado no Resend para o envio passar.
model EmailAccount {
  id            String         @id @default(cuid())
  address       String         @unique
  displayName   String
  /// Assinatura acrescentada ao fim de cada mensagem escrita neste endereço.
  signatureHtml String?
  isDefault     Boolean        @default(false)
  isActive      Boolean        @default(true)
  /// Estado do domínio no Resend, atualizado quando se abre a lista de contas.
  domainStatus  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      EmailMessage[]

  @@index([isActive])
}

model EmailMessage {
  id           String            @id @default(cuid())
  direction    EmailDirection
  folder       EmailFolder       @default(INBOX)
  status       EmailStatus
  /// Identificador da mensagem no Resend.
  resendId     String?           @unique
  /// Message-ID do cabeçalho (RFC 5322), usado para ligar respostas.
  messageId    String?
  inReplyTo    String?
  /// Agrupa a conversa: uma resposta herda o fio da mensagem a que responde.
  threadId     String
  accountId    String?
  account      EmailAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fromAddress  String
  fromName     String?
  toAddresses  String[]
  ccAddresses  String[]
  bccAddresses String[]
  replyTo      String?
  subject      String
  bodyHtml     String?
  bodyText     String?
  /// Primeiras linhas em texto simples, para a lista não carregar o corpo todo.
  snippet      String?
  isRead       Boolean           @default(false)
  isStarred    Boolean           @default(false)
  errorMessage String?
  /// Resultado das verificações de autenticação do remetente (só nas recebidas).
  spfResult    String?
  dkimResult   String?
  dmarcResult  String?
  sentById     String?
  sentBy       User?             @relation("EmailSender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt       DateTime?
  receivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  attachments  EmailAttachment[]
  events       EmailEvent[]

  @@index([folder, createdAt])
  @@index([direction, createdAt])
  @@index([threadId])
  @@index([isRead])
}

model EmailAttachment {
  id                 String       @id @default(cuid())
  messageId          String
  message            EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename           String
  contentType        String?
  size               Int?
  /// Nos anexos recebidos: o id no Resend, com que se pede um link de
  /// descarga temporário. Nos enviados fica vazio e o ficheiro vive no `url`.
  resendAttachmentId String?
  url                String?
  isInline           Boolean      @default(false)

  @@index([messageId])
}

/// Acontecimentos de entrega vindos dos webhooks, para a linha do tempo de
/// uma mensagem enviada (entregue, aberta, devolvida).
model EmailEvent {
  id         String       @id @default(cuid())
  messageId  String
  message    EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type       String
  detail     String?
  occurredAt DateTime
  createdAt  DateTime     @default(now())

  @@index([messageId, occurredAt])
}

/// Mensagens-tipo, para não reescrever o mesmo email de raiz. O corpo pode
/// ter marcadores {{nome}} substituídos no momento de escrever.
model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  locale      Locale   @default(PT)
  subject     String
  bodyHtml    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}
